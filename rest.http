###############################################################################
# BOOKING ENDPOINTS
###############################################################################

### 23. Procedure Booking
POST {{baseUrl}}/booking/procedure-booking
Content-Type: application/json

{
    "name": "John Doe",
    "mobile_number": "9876543210",
    "message": "Need consultation for procedure",
    "procedure_id": {{procedureId}},
    "hospital_id": {{hospitalId}}
}

### 24. Get Wellness List
GET {{baseUrl}}/booking/wellness-list

### 25. Get Wellness Details
GET {{baseUrl}}/booking/wellness-details/{{wellnessCenterId}}

### 26. Doctor Booking (Requires Authentication)
POST {{baseUrl}}/booking/doctor-booking
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "John Doe",
    "mobile_number": "9876543210",
    "hospital_id": {{hospitalId}},
    "doctor_id": {{doctorId}},
    "booking_date": "2024-12-25",
    "required_time_slots": ["09:00 AM", "10:00 AM"],
    "purpose": "General consultation"
}

### 27. Wellness Booking (Requires Authentication)
POST {{baseUrl}}/booking/wellness-booking
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "John Doe",
    "mobile_number": "9876543210",
    "center_id": {{wellnessCenterId}},
    "purpose": "Wellness consultation"
}

### 28. Diagnostic Test Booking - Service (Single/Multi Test) (Requires Authentication)
POST {{baseUrl}}/booking/diagnostic-test-booking
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "type": "service",
    "name": "John Doe",
    "mobile_number": "9876543210",
    "diagnostic_center_id": {{diagnosticCenterId}},
    "test_items": [35,36],
    "sample_collection": "home",
    "booking_date": "2024-12-25",
    "required_time_slots": ["09:00 AM", "10:00 AM"],
    "message": "Routine health checkup"
}

### 29. Diagnostic Test Booking - Package (Requires Authentication)
POST {{baseUrl}}/booking/diagnostic-test-booking
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "type": "package",
    "name": "John Doe",
    "mobile_number": "9876543210",
    "diagnostic_center_id": {{diagnosticCenterId}},
    "package_id": {{packageId}},
    "booking_date": "2024-12-25",
    "sample_collection": "lab",
    "required_time_slots": ["09:00 AM"],
    "message": "Complete health package"
}

### 30. Stem Cell Booking (Requires Authentication)
POST {{baseUrl}}/booking/stem-cell-booking
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "John Doe",
    "mobile_number": "9876543210",
    "booking_date": "2024-12-25",
    "required_time_slots": ["09:00 AM", "10:00 AM"],
    "purpose": "Stem cell consultation"
}

### 31. Caregiver Booking (Requires Authentication)
POST {{baseUrl}}/booking/caregiver-booking
Content-Type: application/json
Authorization: Bearer {{token}}

