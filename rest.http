###############################################################################
# AUTHENTICATION ENDPOINTS
###############################################################################

### 1. User Registration
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "firstName": "John",
    "lastName": "Doe",
    "email": "john.doe@example.com",
    "mobile": "9876543210",
    "gender": "Male",
    "dob": "1990-01-15"
}

### 2. OTP Verification
POST {{baseUrl}}/auth/otp-verification
Content-Type: application/json

{
    "user_id": "{{userId}}",
    "otp": "6564"
}

### 3. Resend OTP
POST {{baseUrl}}/auth/otp-resend
Content-Type: application/json

{
    "user_id": {{userId}}
}

### 4. Login (Send OTP)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "mobile": "9747816550"
}

### 5. Logout (Requires Authentication)
POST {{baseUrl}}/auth/logout
Content-Type: application/json
Authorization: Bearer {{token}}

### 6. Get User Profile (Requires Authentication)
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{token}}

### 7. Update User Profile (Requires Authentication)
POST {{baseUrl}}/auth/form-update
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="firstName"

John
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="lastName"

Doe
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="email"

john.doe@example.com
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="gender"

Male
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="dob"

1990-01-15
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="profile_image"; filename="profile.jpg"
Content-Type: image/jpeg

### 8. Send Verification Email (VERIFY EMAIL button — no sanctum middleware)
# Option A: Bearer token (recommended)
POST {{baseUrl}}/send-verification-email
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "email": "john.doe@example.com"
}

### 8b. Send Verification Email — with user_id (no Bearer header)
POST {{baseUrl}}/send-verification-email
Content-Type: application/json

{
    "user_id": "{{userId}}",
    "email": "john.doe@example.com"
}

### 9. Verify Email (from verification link — no auth)
GET {{baseUrl}}/verify-email/your-email-verification-token-here

### 10. Update Profile — JSON (onboarding fields)
POST {{baseUrl}}/auth/form-update
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "firstName": "John",
    "gender": "Male",
    "dob": "1990-01-15",
    "maritalStatus": "Single",
    "bloodGroup": "O+",
    "preferredBranchId": 1,
    "emergencyContactPersonName": "Jane Doe",
    "emergencyContactPersonPhone": "9876543211",
    "emergencyContactPersonRelationship": "Spouse",
    "houseNumber": "12A",
    "street": "Main Road",
    "city": "Bangalore",
    "state": "Karnataka",
    "zipCode": "560001",
    "email": "john.doe@example.com"
}

###############################################################################
# HOME PAGE ENDPOINTS (HomePageController)
# Base: {{baseUrl}}/home
###############################################################################

### 1. Hospital Branches (branch picker — All Branches / BG Road / Uttarahalli)
GET {{baseUrl}}/home/hospital-branches

### 2. Hospital Locations (legacy branch list with lat/lng)
GET {{baseUrl}}/home/hospital-locations

### 3. Doctor Specialities by Branch (requires hospital_id)
GET {{baseUrl}}/home/doctor-specialities?hospital_id={{hospitalId}}

### 4. Doctors List — All Branches (optional filters)
# sort: name_asc | name_desc | rating_desc | rating_asc | experience_desc | experience_asc | availability | newest | oldest
GET {{baseUrl}}/home/doctors?page=1&per_page=10&sort=availability

### 5. Doctors List — Specific Branch
GET {{baseUrl}}/home/doctors?hospital_id={{hospitalId}}&page=1&per_page=10&sort=name_asc

### 6. Doctors List — Search by speciality name (e.g. Cardiology)
GET {{baseUrl}}/home/doctors?hospital_id={{hospitalId}}&search=Cardiology&page=1&per_page=10

### 7. Doctors List — Search doctor name
GET {{baseUrl}}/home/doctors?hospital_id={{hospitalId}}&search=Rahul&sort=rating_desc

### 8. Doctor List by Branch (legacy — requires hospital_id)
GET {{baseUrl}}/home/doctor-list?hospital_id={{hospitalId}}&page=1&per_page=10

### 9. Doctor Details (profile + calendar + time slots)
# date: optional Y-m-d for slots on that day (defaults to first available day)
GET {{baseUrl}}/home/doctor-details?doctor_id={{doctorId}}&hospital_id={{hospitalId}}

### 10. Doctor Details — slots for specific date
GET {{baseUrl}}/home/doctor-details?doctor_id={{doctorId}}&hospital_id={{hospitalId}}&date=2026-06-01

### 11. Hospital Diagnostic Packages — all branches
GET {{baseUrl}}/home/hospital-diagnostic-packages?page=1&page_limit=10

### 12. Hospital Diagnostic Packages — by hospital (uses hospitals.diagnostic_center_id)
GET {{baseUrl}}/home/hospital-diagnostic-packages?hospital_id={{hospitalId}}&page=1&page_limit=10

### 13. Family Members (Self + dependents — Select Patient UI)
GET {{baseUrl}}/home/family-members
Authorization: Bearer {{token}}

### 14. Booking History — Cancelled (all family)
GET {{baseUrl}}/home/booking-history?type=cancelled&page=1&page_limit=10
Authorization: Bearer {{token}}

### 15. Booking History — Upcoming for Self
GET {{baseUrl}}/home/booking-history?type=upcoming&relationship=Self&page=1
Authorization: Bearer {{token}}

### 16. Booking History — Search doctor or department
GET {{baseUrl}}/home/booking-history?type=upcoming&search=Priya&page=1
Authorization: Bearer {{token}}

### 17. User Coins (Requires Authentication)
GET {{baseUrl}}/home/user-coins
Authorization: Bearer {{token}}

###############################################################################
# HOSPITAL ENDPOINTS (HospitalController)
# Base: {{baseUrl}}/hospital
###############################################################################

### Diagnostic Lab Tests — all hospitals
POST {{baseUrl}}/hospital/diagnostics-services-list
Content-Type: application/json

{
    "page": 1,
    "per_page": 12
}

### Diagnostic Lab Tests — by hospital (hospitals.diagnostic_center_id)
POST {{baseUrl}}/hospital/diagnostics-services-list
Content-Type: application/json

{
    "id": {{hospitalId}},
    "page": 1,
    "per_page": 12
}

###############################################################################
# BOOKING ENDPOINTS (BookingController)
# Base: {{baseUrl}}/booking
###############################################################################

### Doctor Appointment Booking
POST {{baseUrl}}/booking/doctor-booking
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "patient_id": "019d763f-499e-72d5-8e30-3216e5696c93",
    "branch_id": 1,
    "doctor_id": "{{doctorId}}",
    "department_id": 1,
    "appointment_type": "In-Clinic",
    "booking_date": "2026-05-25",
    "required_time_slots": ["02:00 PM"],
    "reason_of_visit": "Pain Management",
    "message": "Knee pain for 2 weeks",
    "device_id": "device-uuid-here"
}

### Diagnostic Package Booking (patient UUID = Self or dependent from persons)
POST {{baseUrl}}/booking/diagnostic-test-booking
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "type": "package",
    "patient_id": "019d763f-499e-72d5-8e30-3216e5696c93",
    "diagnostic_center_id": 1,
    "package_id": 1,
    "sample_collection": "hospital",
    "booking_date": "2026-05-25",
    "required_time_slots": ["09:00 AM", "09:30 AM"],
    "message": "Annual health checkup",
    "device_id": "device-uuid-here"
}

### Diagnostic Service Booking (test_items = diagnostic_lab_tests ids)
# sample_collection: "home" | "hospital" (hospital is stored as lab in DB)
POST {{baseUrl}}/booking/diagnostic-test-booking
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "type": "service",
    "patient_id": "019d763f-499e-72d5-8e30-3216e5696c93",
    "diagnostic_center_id": 1,
    "test_items": [1, 2, 3],
    "sample_collection": "hospital",
    "booking_date": "2026-05-25",
    "required_time_slots": ["10:00 AM"],
    "device_id": "device-uuid-here"
}
