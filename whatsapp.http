    "contacts_uid": [
        "contact-uid-1",
        "contact-uid-2"
    ],
    "groups_uid": [
        "group-uid-1",
        "group-uid-2"
    ]
}

### Response (Success):
# {
#     "result": "success",
#     "message": "Groups assigned successfully"
# }

