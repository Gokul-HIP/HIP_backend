###############################################################################
# CONTACT APIs
###############################################################################

### -----------------------------------------------------------------------
### 12. Create Contact
### Creates a new contact. Phone number must be numeric without + or 0 prefix.
### Include country code in phone number (e.g. 919902233232 for India).
### -----------------------------------------------------------------------
POST {{baseUrl}}/{{vendorUid}}/contact/create
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "first_name": "John",
    "last_name": "Doe",
    "phone_number": "919902233232",
    "email": "john.doe@example.com",
    "country": "India",
    "language_code": "en"
}

### Response (Success):
# {
#     "result": "success",
#     "message": "Contact created successfully",
#     "data": {
#         "contact_uid": "contact-uid",
#         "first_name": "John",
#         "last_name": "Doe",
#         "phone_number": "919902233232",
#         "language_code": "en",
#         "country": "India"
#     }
# }

### Response (Error - Duplicate phone):
# {
#     "result": "failed",
#     "message": "Validation failed",
#     "errors": {
#         "phone_number": ["The phone number has already been taken."]
#     }
# }

