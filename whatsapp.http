###############################################################################
# CAMPAIGN APIs
###############################################################################

### -----------------------------------------------------------------------
### 23. Schedule Campaign
### Creates and schedules a new campaign to send messages to contact groups.
### contact_group: comma-separated group UIDs (string)
### contact_labels: comma-separated label UIDs (string, optional)
### template_name & template_language: required if no preset message
### schedule_at: ISO 8601 date-time (null = send immediately)
### -----------------------------------------------------------------------
POST {{baseUrl}}/{{vendorUid}}/campaign/schedule
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "title": "Summer Promo Campaign",
    "contact_group": "group-uid-1,group-uid-2",
    "contact_labels": "label-uid-1",
    "template_name": "hello_world",
    "template_language": "en_US",
    "timezone": "Asia/Kolkata",
    "schedule_at": "2026-05-20 10:00:00",
    "expire_at": "2026-05-25 23:59:59"
}

### Response (Success):
# {
#     "result": "success",
#     "message": "Campaign scheduled successfully",
#     "data": {
#         "campaign_uid": "campaign-uid",
#         ...
#     }
# }

