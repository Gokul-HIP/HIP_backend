Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "first_name": "John",
    "last_name": "Smith",
    "email": "john.smith@example.com",
    "country": "India",
    "language_code": "en"
}

### Response (Success):
# {
#     "result": "success",
#     "message": "Contact updated successfully",
#     "data": {
#         "contact_uid": "contact-uid"
#     }
# }

