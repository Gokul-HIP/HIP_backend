###############################################################################
# WhatsJet - External API Documentation
# VS Code REST Client Format
#
# Authentication:
#   All external APIs require a Bearer token (vendor API access token)
#   passed via Authorization header or as a ?token= query parameter.
#   The {vendorUid} path parameter identifies the vendor account.
#
# Base URL: {{baseUrl}}/{vendorUid}/...
# Credentials: loaded from .env (WHATSAPP_PROVIDER_*). Do not commit tokens.
###############################################################################

@baseUrl = {{$dotenv WHATSAPP_PROVIDER_BASE_URL}}
@vendorUid = {{$dotenv WHATSAPP_PROVIDER_VENDOR_UID}}
@token = {{$dotenv WHATSAPP_PROVIDER_TOKEN}}
@testPhone = 916381987483

###############################################################################
# TEST — Direct WhatsJet Text Message (raw API, not Laravel workflow)
###############################################################################

### TEST — Direct WhatsJet Text Message
POST {{baseUrl}}/{{vendorUid}}/contact/send-message
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "phone_number": "916381987483",
    "message_body": "HealthInPocket WhatsApp API test message. If you receive this message, the WhatsJet provider integration is working."
}

### TEST — Message Status (log_uid from last successful send)
GET {{baseUrl}}/{{vendorUid}}/contact/message-status?log_uid=df409872-eec9-4676-8c72-7833c2003b7e
Authorization: Bearer {{token}}
Accept: application/json

###############################################################################
# MESSAGING APIs
###############################################################################

### -----------------------------------------------------------------------
### 1. Send Text Message
### Sends a plain text WhatsApp message to a contact by phone number.
### -----------------------------------------------------------------------
POST {{baseUrl}}/{{vendorUid}}/contact/send-message
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "phone_number": "916381987483",
    "message_body": "Hello"
}

### Response (Success):
# {
#     "result": "success",
#     "message": "Message sent successfully",
#     "data": {
#         "log_uid": "unique-log-uid",
#         "contact_uid": "contact-uid",
#         "phone_number": "919902233232",
#         "wamid": "wamid.xxxxxxxxxxxxx",
#         "status": "sent"
#     }
# }

### Response (Error - WhatsApp not configured):
# {
#     "result": "failed",
#     "message": "Please complete your WhatsApp Cloud API Setup first"
# }

### -----------------------------------------------------------------------
### 2. Get Message Status
### Retrieves the delivery status of sent messages.
### Query params: log_uid or wamid (from send message response)
### -----------------------------------------------------------------------
GET {{baseUrl}}/{{vendorUid}}/contact/message-status?log_uid=YOUR_LOG_UID_HERE
Authorization: Bearer {{token}}
Accept: application/json

### Response (Success):
# {
#     "result": "success",
#     "message": "...",
#     "data": {
#         "status": "delivered",
#         "wamid": "wamid.xxxxxxxxxxxxx",
#         "contact_wa_id": "919902233232",
#         "updated_at": "2026-05-15T00:00:00.000000Z"
#     }
# }

### -----------------------------------------------------------------------
### 3. Send Media Message
### Sends a media-based message (image, video, document, audio) via URL.
### Supported media_type values: image, video, document, audio
### -----------------------------------------------------------------------
POST {{baseUrl}}/{{vendorUid}}/contact/send-media-message
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "phone_number": "919902233232",
    "media_type": "image",
    "media_url": "https://example.com/image.jpg",
    "caption": "Check out this image!"
}

### Response (Success):
# {
#     "result": "success",
#     "message": "Message sent successfully",
#     "data": {
#         "log_uid": "unique-log-uid",
#         "contact_uid": "contact-uid",
#         "phone_number": "919902233232",
#         "wamid": "wamid.xxxxxxxxxxxxx",
#         "status": "sent"
#     }
# }

### -----------------------------------------------------------------------
### 4. Send Template Message
### Sends a pre-approved WhatsApp template message.
### Use "Get Template List" API to fetch available template names/languages.
### -----------------------------------------------------------------------
POST {{baseUrl}}/{{vendorUid}}/contact/send-template-message
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "phone_number": "919902233232",
    "template_name": "hello_world",
    "template_language": "en_US",
    "header_image": "https://example.com/header.jpg",
    "components": {
        "body": [
            {
                "type": "text",
                "text": "John"
            },
            {
                "type": "text",
                "text": "your order #12345"
            }
        ]
    }
}

### Response (Success):
# {
#     "result": "success",
#     "message": "Message sent successfully",
#     "data": {
#         "log_uid": "unique-log-uid",
#         "contact_uid": "contact-uid",
#         "phone_number": "919902233232",
#         "wamid": "wamid.xxxxxxxxxxxxx",
#         "status": "sent"
#     }
# }

### -----------------------------------------------------------------------
### 5. Send Carousel Template Message
### Sends a carousel-style template message (same handler as template).
### Uses the same controller method as send-template-message.
### -----------------------------------------------------------------------
POST {{baseUrl}}/{{vendorUid}}/contact/send-carousel-template-message
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "phone_number": "919902233232",
    "template_name": "carousel_promo",
    "template_language": "en_US",
    "components": {
        "body": [
            {
                "type": "text",
                "text": "Summer Sale"
            }
        ],
        "carousel": [
            {
                "card_index": 0,
                "components": [
                    {
                        "type": "header",
                        "parameters": [
                            {
                                "type": "image",
                                "image": {
                                    "link": "https://example.com/card1.jpg"
                                }
                            }
                        ]
                    },
                    {
                        "type": "body",
                        "parameters": [
                            {
                                "type": "text",
                                "text": "Product A"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}

### Response (Success):
# {
#     "result": "success",
#     "message": "Message sent successfully",
#     "data": {
#         "log_uid": "unique-log-uid",
#         "contact_uid": "contact-uid",
#         "phone_number": "919902233232",
#         "wamid": "wamid.xxxxxxxxxxxxx",
#         "status": "sent"
#     }
# }

### -----------------------------------------------------------------------
### 6. Send Interactive Message - Reply Buttons
### Sends an interactive message with quick reply buttons (max 3 buttons).
### interactive_type options: "button" (reply buttons), "list", "cta_url"
### -----------------------------------------------------------------------
POST {{baseUrl}}/{{vendorUid}}/contact/send-interactive-message
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "phone_number": "919902233232",
    "interactive_type": "button",
    "header_type": "text",
    "header_text": "Confirm Your Order",
    "body_text": "Would you like to proceed with your order?",
    "footer_text": "Reply with a button below",
    "buttons": [
        "Yes, Confirm",
        "No, Cancel",
        "View Details"
    ]
}

### Response (Success):
# {
#     "result": "success",
#     "message": "Message sent successfully",
#     "data": {
#         "log_uid": "unique-log-uid",
#         "contact_uid": "contact-uid",
#         "phone_number": "919902233232",
#         "wamid": "wamid.xxxxxxxxxxxxx",
#         "status": "sent"
#     }
# }

### -----------------------------------------------------------------------
### 7. Send Interactive Message - List
### Sends an interactive list message with sections and selectable rows.
### -----------------------------------------------------------------------
POST {{baseUrl}}/{{vendorUid}}/contact/send-interactive-message
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "phone_number": "919902233232",
    "interactive_type": "list",
    "header_type": "text",
    "header_text": "Our Menu",
    "body_text": "Please select an item from the menu below.",
    "footer_text": "Powered by WhatsJet",
    "list_data": {
        "button_text": "View Menu",
        "sections": [
            {
                "title": "Beverages",
                "id": "section_1",
                "rows": [
                    {
                        "id": "row_1",
                        "row_id": "coffee",
                        "title": "Coffee",
                        "description": "Hot brewed coffee - $3.50"
                    },
                    {
                        "id": "row_2",
                        "row_id": "tea",
                        "title": "Tea",
                        "description": "Green or black tea - $2.50"
                    }
                ]
            },
            {
                "title": "Snacks",
                "id": "section_2",
                "rows": [
                    {
                        "id": "row_3",
                        "row_id": "cookie",
                        "title": "Cookie",
                        "description": "Chocolate chip cookie - $1.50"
                    }
                ]
            }
        ]
    }
}

