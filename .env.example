APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# React Flow builder (hip-automation) embedded in Livewire admin
AUTOMATION_UI_URL=https://hip-automation-v35j.vercel.app

# Real-notification automation testing (manual only — keep disabled by default)
# See docs/automation/real-notification-testing.md
AUTOMATION_TEST_ENABLED=false
AUTOMATION_TEST_HOSPITAL_ID=
AUTOMATION_TEST_ORGANIZATION_ID=
AUTOMATION_TEST_USER_ID=
AUTOMATION_TEST_PHONE=
AUTOMATION_TEST_EMAIL=
AUTOMATION_TEST_WHATSAPP=
AUTOMATION_TEST_DEVICE_TOKEN=
# Optional second account: AUTOMATION_TEST_2_USER_ID, AUTOMATION_TEST_2_PHONE, etc.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=healthinpocket_server
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Doctor portal bell / WebSocket notifications (set false to disable)
DOCTOR_NOTIFICATIONS_ENABLED=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_VISION_API_KEY=
GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
IMAGEMAGICK_BINARY=magick
GOOGLE_VISION_CA_BUNDLE=C:\xampp\php\extras\ssl\cacert.pem
GOOGLE_VISION_RENDER_DENSITY=300

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=openrouter/auto

# Coins & payments
AMOUNT_FOR_ONE_COIN=10
REWARD_AMOUNT_PER_COIN=10
COINS_EXPIRY_MONTHS=2
SERVICE_CHARGES=3
PAYMENT_GATEWAY_CHARGES=2
GST_PERCENT=5
