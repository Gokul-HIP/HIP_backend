    {
      "name": "Book doctor appointment",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "description": "Requires X-HMS-Event-Id. The collection sets it from hms_event_id, or generates evt-{timestamp} and stores it. Clear hms_event_id before a new booking. A retry must keep that id; the pre-request script signs again. patient_ref is optional for relationship Self and required for a dependent. consultation_type is in_person (default) or online.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hms_booking_id\": \"HMS-10045\",\n  \"appointment_type\": \"doctor\",\n  \"hospital_code\": \"1\",\n  \"doctor_id\": \"\",\n  \"appointment_date\": \"2026-11-02\",\n  \"slot_time\": \"10:30\",\n  \"original_fee\": 600,\n  \"payable_amount\": 600,\n  \"consultation_type\": \"in_person\",\n  \"patient\": {\n    \"mobile\": \"9990001111\",\n    \"name\": \"Asha Rao\",\n    \"dob\": \"1990-05-01\",\n    \"gender\": \"female\",\n    \"email\": null,\n    \"patient_ref\": \"P-77\",\n    \"relationship\": \"Self\",\n    \"primary_mobile\": null\n  },\n  \"notes\": null\n}"
        },
        "url": {
          "raw": "{{base_url}}/apiv1/client/appointment/booked",
          "host": ["{{base_url}}"],
          "path": ["apiv1", "client", "appointment", "booked"]
        }
      }
    },
