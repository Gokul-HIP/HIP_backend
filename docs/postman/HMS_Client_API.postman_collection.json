{
  "info": {
    "name": "HMS Client API",
    "description": "HMS client API. The pre-request script signs X-HMS-Timestamp and X-HMS-Signature from the raw path, query, and body. Mobile values may include spaces, dashes, a leading 0, or +91 / 91; the server stores the 10-digit local number. An unknown mobile on price/quote returns 200 with patient_exists false and base-tier pricing. Membership and reward for an unknown patient return 404 patient_not_found. Sandbox key and secret are local only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost/HIP_backend/public"},
    {"key": "hms_key", "value": "hms_sandbox_key"},
    {"key": "hms_secret", "value": "hms_sandbox_secret"},
    {"key": "hms_event_id", "value": ""},
    {"key": "hms_payment_event_id", "value": ""}
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const timestamp = Math.floor(Date.now() / 1000).toString();",
          "const method = pm.request.method.toUpperCase();",
          "const path = pm.variables.replaceIn(pm.request.url.getPath());",
          "const query = pm.variables.replaceIn(pm.request.url.getQueryString());",
          "const pathAndQuery = query ? path + '?' + query : path;",
          "let rawBody = '';",
          "if (pm.request.body && pm.request.body.mode === 'raw') {",
          "    rawBody = pm.variables.replaceIn(pm.request.body.raw || '');",
          "}",
          "const canonical = timestamp + '.' + method + '.' + pathAndQuery + '.' + rawBody;",
          "const signature = CryptoJS.HmacSHA256(canonical, pm.collectionVariables.get('hms_secret')).toString(CryptoJS.enc.Hex);",
          "pm.request.headers.upsert({ key: 'X-HMS-Key', value: pm.collectionVariables.get('hms_key') });",
          "pm.request.headers.upsert({ key: 'X-HMS-Timestamp', value: timestamp });",
          "pm.request.headers.upsert({ key: 'X-HMS-Signature', value: signature });",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "if (path.indexOf('/payment-verification') !== -1) {",
          "    let paymentEventId = pm.collectionVariables.get('hms_payment_event_id') || '';",
          "    if (!paymentEventId) {",
          "        paymentEventId = 'pay-' + Date.now();",
          "        pm.collectionVariables.set('hms_payment_event_id', paymentEventId);",
          "    }",
          "    pm.request.headers.upsert({ key: 'X-HMS-Event-Id', value: paymentEventId });",
          "} else if (path.indexOf('/booked') !== -1) {",
          "    let eventId = pm.collectionVariables.get('hms_event_id') || '';",
          "    if (!eventId) {",
          "        eventId = 'evt-' + Date.now();",
          "        pm.collectionVariables.set('hms_event_id', eventId);",
          "    }",
          "    pm.request.headers.upsert({ key: 'X-HMS-Event-Id', value: eventId });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Get patient membership",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/apiv1/client/get/patient/membership?mobile=9990001111&hospital_code=1",
          "host": ["{{base_url}}"],
          "path": ["apiv1", "client", "get", "patient", "membership"],
          "query": [
            {"key": "mobile", "value": "9990001111"},
            {"key": "hospital_code", "value": "1"},
            {"key": "patient_ref", "value": "", "disabled": true}
          ]
        }
      }
    },
