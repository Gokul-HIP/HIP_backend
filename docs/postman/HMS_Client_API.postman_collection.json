    {
      "name": "Payment verification",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "description": "Requires X-HMS-Event-Id from hms_payment_event_id (separate from the booking event id). Clear hms_payment_event_id before a new payment. A retry must be signed again and must keep the same X-HMS-Event-Id and the same payment.reference. Amount must match the HIP total within 0.01.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hms_booking_id\": \"HMS-10045\",\n  \"payment\": {\n    \"reference\": \"RCPT-8891\",\n    \"status\": \"success\",\n    \"amount\": 605.94,\n    \"method\": \"cash\",\n    \"paid_at\": \"2026-10-28T16:45:00+05:30\"\n  }\n}"
        },
        "url": {
