{
  "schema_version": "1.0",
  "name": "Appointment Booked Confirmation",
  "trigger_type": "appointmentBooked",
  "module": "appointment",
  "definition": {
    "builderVersion": "1",
    "nodes": [
      {
        "id": "t1",
        "type": "workflow",
        "position": { "x": 100, "y": 100 },
        "data": { "nodeType": "appointmentBooked" }
      },
      {
        "id": "d1",
        "type": "workflow",
        "position": { "x": 300, "y": 100 },
        "data": { "nodeType": "delay", "type": "minutes", "value": 5 }
      },
      {
        "id": "w1",
        "type": "workflow",
        "position": { "x": 500, "y": 100 },
        "data": {
          "nodeType": "sendWhatsApp",
          "messageTemplate": "Hi {{PatientName}}, your appointment with Dr. {{DoctorName}} at {{HospitalName}} is confirmed for {{AppointmentDate}} at {{AppointmentTime}}."
        }
      },
      {
        "id": "e1",
        "type": "workflow",
        "position": { "x": 700, "y": 100 },
        "data": { "nodeType": "end" }
      }
    ],
    "edges": [
      { "id": "e1", "source": "t1", "target": "d1" },
      { "id": "e2", "source": "d1", "target": "w1" },
      { "id": "e3", "source": "w1", "target": "e1" }
    ]
  }
}
